@* Sidebar navigation for the component gallery, using NavSection/NavItem so
   entries match the shell's own sections without hand-typing ag-nav-* markup. *@
@inject IStringLocalizer<Strings> L

<NavSection Title="@L["Nav.SectionGettingStarted"]">
    <NavItem Href="" Text="@L["Nav.Overview"]" Match="NavLinkMatch.All" />
    <NavItem Href="tokens" Text="@L["Nav.TokensTypography"]" />
    <NavItem Href="icons" Text="@L["Nav.Icons"]" />
</NavSection>

<NavSection Title="@L["Nav.SectionComponents"]">
    <NavItem Href="buttons" Text="@L["Nav.ButtonsBadges"]" />
    <NavItem Href="forms" Text="@L["Nav.Forms"]" />
    <NavItem Href="data-grid" Text="@L["Nav.DataGrid"]" />
    <NavItem Href="feedback" Text="@L["Nav.Feedback"]" />
    <NavItem Href="settings" Text="@L["Nav.Settings"]" />
</NavSection>

<NavSection Title="@L["Nav.SectionPatterns"]">
    <NavItem Href="login" Text="@L["Nav.LoginShell"]" />
</NavSection>
