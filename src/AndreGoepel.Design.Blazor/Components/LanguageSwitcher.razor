@inherits LocalizedComponentBase
@using Microsoft.Extensions.Options

@* Language switch: one item per culture configured via AddDesignBlazor, styled
   like ThemeToggle but labelled with the language code.

   Deliberately NOT interactive. Each item is a plain anchor to the culture
   endpoint mapped by UseDesignBlazorLocalization, so the switch also works on
   statically rendered pages (e.g. the ASP.NET Core Identity pages) and needs no
   circuit. Requires app.UseDesignBlazorLocalization(). The links themselves come
   from CultureLinks.Build — shared so a host can render its own unstyled switch
   from the same logic. *@
@inject IOptions<DesignBlazorOptions> Options
@inject NavigationManager Navigation

<div class="ag-lang-toggle" role="group" aria-label="@T("Language.GroupLabel")">
    @foreach (var culture in CultureLinks.Build(Options.Value, Navigation))
    {
        <a class="ag-lang-btn @(culture.IsActive ? "ag-active" : string.Empty)"
           href="@culture.Href"
           title="@culture.DisplayName"
           aria-label="@culture.DisplayName"
           aria-current="@(culture.IsActive ? "true" : null)"
           data-enhance-nav="false">@culture.Code</a>
    }
</div>
